# ByteChain frontend environment configuration
#
# The Vite dev server already proxies requests whose path starts with
# "/api" to http://127.0.0.1:8000 (see client/vite.config.js), so for
# local development you can leave VITE_API_BASE_URL empty.
#
# When you need to point the UI at a different host (e.g. a deployed
# backend, or a non-default local port), set the full origin:
#
#   VITE_API_BASE_URL=http://localhost:8000
#   VITE_API_BASE_URL=https://api.bytechain.example.com
#
# Do NOT commit a real secret to this file.

VITE_API_BASE_URL=
